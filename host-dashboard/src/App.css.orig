/* ============================================================
   Iris SYNCD — Host Dashboard (Gridline System)
   Inspired by Watermelon Gridline Dashboard Architecture
   ============================================================ */

.gridline-app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--text-primary);
  position: relative;
}

/* ---------- Top Status Strip ---------- */

.gridline-status-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.35rem 1.25rem;
  background: #060608;
  border-bottom: 1px solid var(--border);
  font-size: 0.68rem;
  font-family: var(--font-mono);
  color: var(--text-tertiary);
  user-select: none;
}

.status-strip-left,
.status-strip-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-sm);
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: var(--accent-green);
  font-weight: 600;
  letter-spacing: 0.05em;
}

.status-dot-pulse {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-green);
  box-shadow: 0 0 8px var(--accent-green);
  animation: pulse-ring 1.8s infinite;
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
  70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.status-divider {
  color: rgba(255, 255, 255, 0.15);
}

.status-metric {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--text-secondary);
}

/* ---------- Gridline Header ---------- */

.gridline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.5rem;
  background: rgba(15, 15, 19, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-strong);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.brand-logo {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-magenta));
  color: #fff;
  box-shadow: 0 4px 16px rgba(139, 92, 246, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.brand-titles {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  line-height: 1.2;
}

.brand-badge {
  font-size: 0.62rem;
  font-family: var(--font-mono);
  font-weight: 600;
  letter-spacing: 0.1em;
  color: var(--accent-violet-light);
}

.header-center-panel {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  padding: 0.35rem 0.85rem;
  border-radius: var(--radius-lg);
}

.session-tag {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.session-label {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
}

.session-value {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--accent-violet-light);
  letter-spacing: 0.12em;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* Connection Pill */
.connection-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.8rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-family: var(--font-mono);
  font-weight: 600;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  color: var(--text-secondary);
}

.pill-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-tertiary);
}

.connection-pill.connected {
  border-color: rgba(16, 185, 129, 0.4);
  color: var(--accent-green);
  background: rgba(16, 185, 129, 0.08);
}
.connection-pill.connected .pill-dot {
  background: var(--accent-green);
  box-shadow: 0 0 8px var(--accent-green);
}

.connection-pill.disconnected {
  border-color: rgba(244, 63, 94, 0.4);
  color: var(--accent-rose);
  background: rgba(244, 63, 94, 0.08);
}
.connection-pill.disconnected .pill-dot {
  background: var(--accent-rose);
}

.connection-pill.reconnecting .pill-dot {
  background: var(--accent-amber);
  animation: pulse-ring 1s infinite;
}

/* ---------- Buttons ---------- */

.gridline-btn-primary,
.gridline-btn-ghost,
.gridline-btn-danger,
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 0.85rem;
  font-weight: 600;
  font-family: inherit;
  padding: 0.55rem 1.1rem;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  cursor: pointer;
  user-select: none;
  transition: all var(--speed-normal) var(--ease);
}

.gridline-btn-primary,
.btn-primary {
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-magenta));
  color: #fff;
  box-shadow: 0 4px 14px rgba(139, 92, 246, 0.3);
}
.gridline-btn-primary:hover:not(:disabled),
.btn-primary:hover:not(:disabled) {
  filter: brightness(1.1);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(139, 92, 246, 0.45);
}

.gridline-btn-ghost,
.btn-secondary {
  background: var(--bg-subtle);
  border-color: var(--border);
  color: var(--text-primary);
}
.gridline-btn-ghost:hover:not(:disabled),
.btn-secondary:hover:not(:disabled) {
  background: var(--bg-hover);
  border-color: var(--border-strong);
}

.gridline-btn-danger,
.btn-danger {
  background: rgba(244, 63, 94, 0.1);
  border-color: rgba(244, 63, 94, 0.3);
  color: var(--accent-rose);
}
.gridline-btn-danger:hover:not(:disabled),
.btn-danger:hover:not(:disabled) {
  background: var(--accent-rose);
  color: #fff;
  border-color: var(--accent-rose);
  box-shadow: 0 4px 14px rgba(244, 63, 94, 0.35);
}

.btn-sm {
  padding: 0.35rem 0.75rem;
  font-size: 0.78rem;
  border-radius: var(--radius-sm);
}

/* ---------- Layout Body & Sidebar ---------- */

.gridline-body {
  display: flex;
  flex: 1;
  min-height: calc(100vh - 85px);
}

.gridline-sidebar {
  width: 240px;
  background: rgba(12, 12, 16, 0.9);
  border-right: 1px solid var(--border);
  padding: 1rem 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  transition: width var(--speed-normal) var(--ease);
  flex-shrink: 0;
}

.gridline-sidebar.collapsed {
  width: 64px;
  align-items: center;
}

.sidebar-toggle-bar {
  display: flex;
  justify-content: flex-end;
}
.collapsed .sidebar-toggle-bar {
  justify-content: center;
}

.sidebar-toggle-btn {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  width: 28px;
  height: 28px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all var(--speed-fast);
}
.sidebar-toggle-btn:hover {
  color: var(--text-primary);
  border-color: var(--border-strong);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.84rem;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: all var(--speed-fast);
  white-space: nowrap;
}
.collapsed .nav-item {
  justify-content: center;
  padding: 0.65rem;
}

.nav-item:hover {
  background: var(--bg-subtle);
  color: var(--text-primary);
}

.nav-item.active {
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.3);
  color: var(--accent-violet-light);
}

.sidebar-footer-card {
  margin-top: auto;
  padding: 0.85rem;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.footer-card-header {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.72rem;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 0.35rem;
}

.footer-card-desc {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  line-height: 1.35;
}

/* ---------- Gridline Content Container ---------- */

.gridline-content {
  flex: 1;
  padding: 1.5rem 2rem;
  overflow-y: auto;
}

/* ---------- Create Session Landing ---------- */

.create-session-container {
  max-width: 580px;
  margin: 4rem auto;
  text-align: center;
  padding: 2.5rem;
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-xl);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.landing-icon-wrapper {
  display: grid;
  place-items: center;
  width: 64px;
  height: 64px;
  border-radius: 20px;
  background: linear-gradient(135deg, var(--accent-violet), var(--accent-magenta));
  color: #fff;
  margin: 0 auto 1.5rem;
  box-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
}

.create-session-container h2 {
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 0.5rem;
}

.create-session-container p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin-bottom: 1.75rem;
}

/* ---------- Dashboard Grid Layout ---------- */

.gridline-dashboard-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1.25rem;
}

.col-span-12 { grid-column: span 12 / span 12; }
.col-span-8 { grid-column: span 8 / span 8; }
.col-span-4 { grid-column: span 4 / span 4; }

/* Gridline Card Shell */
.gridline-card {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.6);
  transition: border-color var(--speed-normal);
}

.gridline-card:hover {
  border-color: var(--border-strong);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border);
}

.card-title-group {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.card-title-icon {
  color: var(--accent-violet-light);
}

.card-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-primary);
}

.card-badge {
  font-size: 0.65rem;
  font-family: var(--font-mono);
  font-weight: 600;
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-sm);
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  color: var(--text-secondary);
}

/* Metric Cards */
.metrics-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.85rem;
}

.metric-box {
  padding: 0.85rem;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.metric-label {
  font-size: 0.68rem;
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--text-tertiary);
  text-transform: uppercase;
}

.metric-value {
  font-size: 1.35rem;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--accent-violet-light);
}

/* QR Code & Invite Panel */
.qr-flex-wrapper {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.qr-box {
  background: #fff;
  padding: 0.85rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-strong);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.invite-info-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-width: 200px;
}

.url-input-group {
  display: flex;
  gap: 0.5rem;
}

.url-input-group input {
  flex: 1;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  color: var(--text-primary);
  padding: 0.5rem 0.85rem;
  border-radius: var(--radius-md);
  font-family: var(--font-mono);
  font-size: 0.82rem;
}

/* Device Cards Grid */
.device-fleet-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 0.85rem;
}

.device-card-item {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 0.85rem;
  cursor: pointer;
  transition: all var(--speed-normal) var(--ease);
}
.device-card-item:hover {
  border-color: var(--border-accent);
  transform: translateY(-2px);
}
.device-card-item.selected {
  border-color: var(--accent-violet-light);
  box-shadow: 0 0 0 1px var(--accent-violet-light), 0 8px 20px rgba(139, 92, 246, 0.25);
}

.device-card-top {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.device-card-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  background: rgba(139, 92, 246, 0.12);
  color: var(--accent-violet-light);
  border: 1px solid rgba(139, 92, 246, 0.25);
}

.device-card-info h4 {
  font-size: 0.88rem;
  font-weight: 600;
}
.device-card-info span {
  font-size: 0.68rem;
  font-family: var(--font-mono);
  color: var(--text-tertiary);
}

/* Camera Grid */
.camera-feeds-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}

.camera-feed-box {
  position: relative;
  aspect-ratio: 16 / 10;
  background: #000;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  cursor: pointer;
  transition: all var(--speed-normal);
}
.camera-feed-box:hover {
  border-color: var(--accent-magenta);
  transform: scale(1.02);
  box-shadow: 0 12px 30px rgba(217, 70, 239, 0.25);
}

.camera-feed-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.camera-feed-bar {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 0.6rem 0.75rem;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.78rem;
}

.live-indicator-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.15rem 0.45rem;
  border-radius: 999px;
  background: rgba(244, 63, 94, 0.85);
  color: #fff;
  font-size: 0.62rem;
  font-family: var(--font-mono);
  font-weight: 700;
}

/* Responsive Overrides */
@media (max-width: 960px) {
  .col-span-8, .col-span-4 { grid-column: span 12 / span 12; }
  .gridline-content { padding: 1rem; }
  .gridline-header { flex-wrap: wrap; gap: 0.75rem; }
  .header-center-panel { order: 3; width: 100%; justify-content: space-between; }
}
